<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#080d19" />
<meta name="description" content="An interactive Telugu Panchangam-inspired almanac for 2001–2101. Explore 100 Samvatsarams, 12 Rasis, planetary lords and traditional yearly indices." />
<title>Rāśi • An Interactive Telugu Almanac | 2001–2101</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+Telugu:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
:root{--bg:#080d19;--bg2:#0f1524;--glass:rgba(19,27,45,.71);--glass2:rgba(17,24,39,.83);--line:rgba(217,196,142,.15);--line2:rgba(220,206,169,.29);--muted:#a9adba;--text:#f4f1ec;--gold:#e3c48a;--gold2:#fff0cd;--teal:#82d6c0;--rose:#e8a9bb;--lav:#bdaeea;--serif:'Cormorant Garamond',Georgia,serif;--sans:'DM Sans',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;--tel:'Noto Sans Telugu',sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-width:320px;background:radial-gradient(circle at 20% 10%,#111d34 0,#0a1020 30%,#060a14 68%,#04070e 100%);color:var(--text);font-family:var(--sans);line-height:1.55;overflow-x:hidden}
::selection{color:#111726;background:#f1d8a3}
button,input,select{font:inherit}
button,select{cursor:pointer}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
a{color:inherit}
button{border:0}
#spaceCanvas{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:-3;display:block;filter:saturate(1.10) brightness(.98)}
.page:after{content:"";position:fixed;inset:0;pointer-events:none;z-index:-2;background:radial-gradient(circle at 50% 25%,transparent 0,transparent 30%,rgba(4,7,14,.12) 52%,rgba(4,7,14,.45) 100%),linear-gradient(180deg,rgba(6,10,20,.12),rgba(6,10,20,.36));}
#stars{display:none}
.star{position:absolute;border-radius:50%;background:#f9ebcf;box-shadow:0 0 6px #e1c68f;opacity:var(--op);width:var(--size);height:var(--size);animation:twinkle var(--dur) ease-in-out infinite alternate,starFloat var(--drift) ease-in-out infinite alternate;animation-delay:var(--delay),var(--delay2)}
@keyframes starFloat{from{transform:translate3d(0,0,0) scale(.9)}to{transform:translate3d(var(--dx),var(--dy),0) scale(1.14)}}
.bg-glow{position:fixed;pointer-events:none;z-index:-1;filter:blur(25px);border-radius:50%}
.glow-one{top:-240px;left:-170px;width:850px;height:850px;background:radial-gradient(circle,rgba(71,88,134,.17) 0,rgba(13,24,54,.08) 43%,transparent 71%)}
.glow-two{top:320px;right:-260px;width:870px;height:870px;background:radial-gradient(circle,rgba(122,72,93,.18),rgba(33,24,45,.06) 47%,transparent 70%)}
.hero{position:relative}
.selection-card,.metric,.profile-card,.balance-card,.method-card,.archive-toolbar,.archive-table-wrap,.topbar{backdrop-filter:blur(14px)}
@media print{#spaceCanvas,.motion-toggle{display:none!important}}
.motion-toggle{border:1px solid rgba(218,201,167,.26);color:#e8d6b1;background:rgba(8,15,29,.58);border-radius:20px;padding:8px 12px;font-size:10px;font-weight:600;white-space:nowrap;letter-spacing:.02em;backdrop-filter:blur(8px);transition:border-color .25s,background .25s}
.motion-toggle:hover{border-color:rgba(237,214,173,.62);background:rgba(19,30,49,.75)}
@media(max-width:740px){.motion-toggle{padding:7px 9px;font-size:9px}}
@media(max-width:400px){.motion-toggle{font-size:0;width:29px;height:29px;padding:0}.motion-toggle:before{content:"✦";font-size:15px}}
@media(prefers-reduced-motion:reduce){.astro-wheel:after,.star{animation:none!important}}
@keyframes twinkle{from{opacity:calc(var(--op)*.24)}to{opacity:var(--op)}}
.page{position:relative;isolation:isolate;min-height:100vh;overflow-x:clip}
.page:before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(to right,rgba(221,204,155,.025) 1px,transparent 1px),linear-gradient(to bottom,rgba(221,204,155,.02) 1px,transparent 1px);background-size:75px 75px;mask-image:linear-gradient(to bottom,black,transparent 75%)}
.container{width:min(1220px,calc(100% - 72px));margin-inline:auto;position:relative;z-index:1}
.topbar{border-bottom:1px solid rgba(222,203,161,.1);position:relative;z-index:5;backdrop-filter:blur(14px);background:rgba(7,12,23,.55)}
.topbar-inner{height:77px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none}
.logo-mark{width:39px;height:39px;display:grid;place-items:center;border:1px solid rgba(228,203,150,.45);border-radius:50%;color:var(--gold);font-size:21px;position:relative;box-shadow:inset 0 0 0 5px rgba(224,196,137,.055)}
.logo-mark:after{position:absolute;inset:5px;content:"";border:1px dotted rgba(224,196,137,.45);border-radius:50%;transform:rotate(20deg)}
.logo-type{font-family:var(--serif);font-size:29px;letter-spacing:.055em;line-height:1}
.logo-caption{display:block;font-family:var(--sans);text-transform:uppercase;letter-spacing:.18em;font-size:8px;color:var(--muted);margin-top:5px;font-weight:600}
.toplinks{display:flex;align-items:center;gap:30px}
.toplinks a{font-size:12px;font-weight:600;letter-spacing:.045em;text-decoration:none;color:#c7c7cd;transition:color .2s}
.toplinks a:hover{color:var(--gold2)}
.top-pill{font-size:10px;padding:9px 13px;letter-spacing:.1em;text-transform:uppercase;border:1px solid var(--line2);color:#dbc79e;border-radius:40px;white-space:nowrap}
.hero{padding:66px 0 36px;display:grid;grid-template-columns:1.06fr .94fr;gap:20px;align-items:center;min-height:510px}
.eyebrow{display:flex;gap:12px;align-items:center;color:var(--gold);font-size:10px;text-transform:uppercase;letter-spacing:.27em;font-weight:700}
.eyebrow:before{content:"";width:29px;height:1px;background:var(--gold)}
.hero h1{font-family:var(--serif);font-size:clamp(62px,6.5vw,101px);font-weight:500;letter-spacing:-.053em;line-height:.91;max-width:740px;margin:27px 0 24px}
.hero h1 em{font-weight:500;color:var(--gold);font-style:italic}
.hero p{font-size:14px;line-height:1.85;color:#c1bec8;max-width:490px}
.hero-actions{display:flex;align-items:center;gap:18px;flex-wrap:wrap;margin:32px 0 0}
.btn-primary{padding:14px 20px;display:inline-flex;align-items:center;gap:10px;color:#171c27;background:linear-gradient(110deg,#ffefd2,#d9b674);border:1px solid #f6d9a3;border-radius:8px;font-size:12px;font-weight:700;letter-spacing:.02em;box-shadow:0 7px 30px rgba(220,173,104,.12);transition:transform .2s,filter .2s}
.btn-primary:hover{transform:translateY(-2px);filter:brightness(1.06)}
.btn-text{background:none;color:var(--gold2);font-size:12px;font-weight:600;padding:12px 0;border-bottom:1px solid rgba(222,190,126,.5)}
.btn-text:hover{color:white}
.hero-aside{display:flex;align-items:center;justify-content:center;min-height:440px;position:relative}
.astro-wheel{position:relative;width:min(445px,100%);aspect-ratio:1;border-radius:50%;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 0 55px rgba(224,178,103,.05))}
.astro-wheel:before{content:"";position:absolute;inset:1%;border:1px solid rgba(225,191,133,.24);border-radius:50%}
.astro-wheel:after{content:"";position:absolute;inset:8%;border:1px dashed rgba(225,191,133,.32);border-radius:50%;animation:spin 100s linear infinite;pointer-events:none}
.ring{position:absolute;inset:16%;border:1px solid rgba(225,191,133,.16);border-radius:50%;box-shadow:0 0 0 28px rgba(175,153,117,.018)}
.ring:before{content:"";position:absolute;inset:17%;border-radius:50%;border:1px solid rgba(225,191,133,.3)}
.ring:after{content:"";position:absolute;inset:1%;border-radius:50%;border:1px dotted rgba(225,191,133,.17)}
.orbit-lines{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;opacity:.55}
.orbit-lines svg{width:94%;height:94%}
@keyframes spin{to{transform:rotate(360deg)}}
.wheel-center{position:relative;width:40%;aspect-ratio:1;border:1px solid rgba(223,197,144,.36);background:radial-gradient(circle at 40% 35%,rgba(40,51,73,.93),rgba(12,17,31,.98) 70%);border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;z-index:2;box-shadow:0 15px 75px rgba(3,8,20,.68),0 0 28px rgba(206,162,106,.08),inset 0 0 60px rgba(204,166,98,.05)}
.wheel-center:after{content:"";position:absolute;inset:7px;border:1px dotted rgba(207,187,149,.35);border-radius:50%}
.wheel-glyph{font-family:serif;font-size:clamp(42px,6vw,78px);line-height:1;color:#f6dba7;text-shadow:0 0 25px rgba(247,204,138,.22)}
.wheel-center span:last-child{font-family:var(--serif);font-size:22px;letter-spacing:.07em;color:#d2c2a3}
.wheel-sign{position:absolute;z-index:3;display:grid;place-items:center;width:37px;height:37px;border-radius:50%;background:#131c2c;border:1px solid rgba(223,201,158,.13);color:#aaa6a2;font:25px Georgia,serif;transition:background .22s,color .22s,border-color .22s,transform .22s;transform:translate(-50%,-50%)}
.wheel-sign:hover{color:#f1d5a0;background:#243047;border-color:var(--gold)}
.wheel-sign.active{color:#101724;background:linear-gradient(130deg,#ffebc1,#d2a969);border-color:#f3d5a2;box-shadow:0 0 24px rgba(229,182,108,.36);transform:translate(-50%,-50%) scale(1.12)}
.wheel-corner{position:absolute;right:3%;bottom:2%;font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:#c6af85;opacity:.65}
.line-sep{height:1px;background:linear-gradient(90deg,transparent,rgba(229,196,147,.3),transparent)}
.section-eyebrow{font-size:10px;letter-spacing:.19em;text-transform:uppercase;color:#c9b18a;font-weight:700}
.section-heading{font:500 clamp(34px,4.2vw,50px)/1 var(--serif);letter-spacing:-.035em;margin:10px 0 0}
.section-caption{color:var(--muted);font-size:13px;max-width:550px}
.section-heading-row{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:25px}
.explorer{padding:60px 0 10px}
.selection-card{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:24px;background:linear-gradient(150deg,rgba(26,35,53,.94),rgba(13,20,33,.94));border:1px solid rgba(219,185,128,.23);border-radius:16px;padding:27px;box-shadow:0 24px 80px rgba(0,0,0,.18);overflow:hidden}
.selection-card:before{content:"";position:absolute;right:-80px;top:-170px;width:370px;height:370px;border-radius:50%;background:radial-gradient(circle,rgba(199,143,91,.08),transparent 69%);pointer-events:none}
.control-group{position:relative;z-index:1;min-width:0}
.control-label{display:flex;justify-content:space-between;gap:10px;color:#d6d4d5;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px}
.field-note{font-size:10px;font-weight:400;text-transform:none;letter-spacing:0;color:#a59d9e}
.select-wrap{position:relative}
select{width:100%;appearance:none;-webkit-appearance:none;background:rgba(6,11,23,.59);border:1px solid rgba(203,189,162,.23);border-radius:9px;color:#f4ead8;padding:17px 44px 17px 17px;font-size:14px;font-weight:600;outline:none;transition:border-color .2s,box-shadow .2s}
select:hover,select:focus{border-color:rgba(225,199,148,.7);box-shadow:0 0 0 3px rgba(202,158,95,.055)}
select option{background:#172035;color:white}
.chevron{position:absolute;right:18px;top:50%;transform:translateY(-50%) rotate(45deg);width:9px;height:9px;border-bottom:1.5px solid #ddc093;border-right:1.5px solid #ddc093;pointer-events:none}
.choice-summary{margin-top:10px;font-size:11px;color:#acabb5;min-height:17px}
.choice-summary strong{font-weight:600;color:#e9d4a9}
.rashi-section{padding:36px 0 0}
.rashi-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
.rashi-button{background:linear-gradient(145deg,rgba(23,32,47,.74),rgba(13,20,35,.65));border:1px solid rgba(221,198,162,.13);border-radius:12px;min-height:121px;padding:15px 8px 12px;color:#e4d9ca;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;transition:transform .2s,border-color .2s,background .2s,box-shadow .2s}
.rashi-button:hover{transform:translateY(-3px);border-color:rgba(223,194,149,.43);background:rgba(41,49,63,.76)}
.rashi-button.active{border-color:#d9b680;background:linear-gradient(155deg,rgba(67,60,63,.77),rgba(29,32,46,.97));box-shadow:inset 0 0 38px rgba(219,184,109,.09),0 8px 23px rgba(0,0,0,.21)}
.rashi-button .glyph{font:38px Georgia,serif;line-height:1.16;color:#dec49c;margin-bottom:5px}
.rashi-button.active .glyph{color:#ffe4ab;text-shadow:0 0 18px rgba(251,207,133,.35)}
.rashi-button .r-name{font-size:12px;font-weight:700;white-space:nowrap}
.rashi-button .r-local{font-family:var(--tel);font-size:10px;color:#9d9da9}
.rashi-button.active .r-local{color:#dec69f}
.results{padding:83px 0 0}
.overline{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold)}
.result-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:23px}
.result-title{font:500 clamp(36px,4.1vw,56px)/1.03 var(--serif);letter-spacing:-.035em;margin:8px 0}
.result-sub{font:400 13px var(--tel),var(--sans);color:#b9b0ac}
.button-row{display:flex;gap:9px;flex-wrap:wrap}
.btn-outline{background:rgba(34,40,53,.48);color:#e2d6c1;border:1px solid rgba(230,195,146,.24);border-radius:8px;padding:11px 13px;display:inline-flex;gap:8px;align-items:center;font-size:11px;font-weight:700;transition:background .15s,border-color .15s}
.btn-outline:hover{background:rgba(65,59,60,.5);border-color:#ccad81}
.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.metric{background:linear-gradient(160deg,rgba(30,39,56,.84),rgba(17,25,41,.87));border:1px solid rgba(221,201,163,.15);border-radius:14px;min-height:255px;padding:23px 22px;position:relative;overflow:hidden;box-shadow:0 10px 34px rgba(0,0,0,.07)}
.metric:before{position:absolute;content:"";width:150px;height:150px;right:-75px;top:-82px;filter:blur(28px);border-radius:50%;background:var(--soft)}
.metric-top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.metric-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:9px;background:var(--soft);color:var(--accent);font-size:18px}
.metric-max{font-size:10px;color:#b0aeba;letter-spacing:.06em}
.metric-title{margin:20px 0 0;font-size:13px;letter-spacing:.018em;font-weight:700}
.metric-local{font-size:10px;color:#a5a2a9;font-family:var(--tel)}
.metric-main{display:flex;align-items:baseline;gap:7px;margin:8px 0 13px}
.metric-value{font:500 65px/.95 var(--serif);color:var(--accent);letter-spacing:-.045em;transition:color .2s}
.metric-max2{font-size:13px;color:#8b90a1}
.metric-track{height:5px;border-radius:30px;background:#303342;overflow:hidden;margin-top:4px}
.metric-fill{width:0%;height:100%;background:var(--accent);border-radius:30px;transition:width .45s ease}
.metric-bottom{color:#b0aeb8;font-size:10px;margin-top:13px;letter-spacing:.025em}
.aad{--accent:var(--teal);--soft:rgba(91,196,169,.12)}.vya{--accent:var(--rose);--soft:rgba(232,142,172,.12)}.raj{--accent:var(--gold);--soft:rgba(214,164,98,.12)}.ava{--accent:var(--lav);--soft:rgba(156,142,230,.12)}
.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
.profile-card{border:1px solid rgba(221,199,156,.16);border-radius:14px;padding:24px 26px;background:rgba(20,28,45,.66);display:flex;gap:18px;align-items:center}
.profile-icon{flex-shrink:0;display:grid;place-items:center;width:61px;height:61px;border-radius:50%;font:39px Georgia,serif;color:#e6c28c;background:radial-gradient(circle,rgba(224,181,110,.14),rgba(229,203,158,.025));border:1px solid rgba(222,189,137,.25)}
.profile-card .pc-label{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#b9b0a5;font-weight:700}
.profile-card .pc-name{font:500 30px/1.15 var(--serif);margin:5px 0 1px}
.profile-card .pc-desc{font-size:11px;color:#afb0bf}
.profile-card strong{color:#e5cc9e;font-weight:700}
.numerology-note{display:flex;align-items:start;gap:10px;border:1px solid rgba(208,188,149,.15);background:rgba(14,22,35,.8);padding:15px 16px;color:#bdb6b6;font-size:11px;line-height:1.7;border-radius:9px;margin-top:17px}
.info-symbol{color:var(--gold);font-size:14px;font-weight:bold;flex:none;margin-top:-1px}
.analysis-grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:35px}
.balance-card,.method-card,.archive-card{border:1px solid var(--line);border-radius:15px;background:linear-gradient(145deg,rgba(23,32,49,.77),rgba(13,20,33,.89));padding:26px;position:relative;overflow:hidden}
.card-title{font:500 29px/1 var(--serif);margin:4px 0 6px;letter-spacing:-.01em}
.card-caption{color:#a9a8b3;font-size:11px;line-height:1.7;margin:0}
.balance-row{margin-top:29px}
.balance-heading{display:flex;justify-content:space-between;align-items:baseline;font-size:12px;gap:12px}
.balance-heading span:first-child{color:#b6b4bc}
.balance-heading strong{font-size:12px;font-weight:700;color:#ded0b8}
.balance-track{height:12px;background:rgba(58,55,68,.75);border-radius:20px;overflow:hidden;display:flex;margin-top:11px}
.balance-track .positive{background:linear-gradient(90deg,#5ba795,#a3ddbd);height:100%;transition:width .45s ease}
.balance-track .negative{background:linear-gradient(90deg,#e1ab9d,#d57e9c);height:100%;transition:width .45s ease}
.balance-description{font-size:11px;color:#c9c1bf;line-height:1.8;margin-top:22px;min-height:44px}
.calc-section,.archive-section{padding:80px 0 0}
.calc-section .section-heading-row,.archive-section .section-heading-row{margin-bottom:23px}
.method-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.method-card{padding:24px;min-height:222px}
.method-step{font-size:10px;font-weight:700;letter-spacing:.13em;color:#ccba94;text-transform:uppercase}
.method-card h3{font:500 27px var(--serif);margin:14px 0 6px}
.formula{font:500 12px/1.8 ui-monospace,SFMono-Regular,Consolas,monospace;color:#d5dcdf;white-space:normal;overflow-wrap:anywhere;margin-top:12px}
.formula strong{color:#e3c18d;font-size:16px}
.method-note{color:#a6a5ae;font-size:10px;margin-top:8px}
.method-explainer{margin-top:15px;color:#aeb0ba;font-size:11px;line-height:1.8}
.archive-shell{display:grid;grid-template-columns:1fr;gap:20px}
.archive-card{padding:0;overflow:hidden}
.archive-toolbar{padding:22px 24px;display:flex;justify-content:space-between;gap:15px;align-items:center;flex-wrap:wrap;border-bottom:1px solid var(--line)}
.archive-title{font:500 28px var(--serif)}
.archive-desc{color:#a5a7b2;font-size:11px;margin-top:3px}
.archive-actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
.search-wrap{position:relative}
.search-wrap:before{content:"⌕";position:absolute;top:50%;left:12px;transform:translateY(-53%);font-size:20px;color:#aaa7a5}
#archiveSearch{background:rgba(7,13,25,.8);color:white;border:1px solid rgba(215,185,144,.25);border-radius:7px;padding:10px 11px 10px 34px;font-size:12px;width:195px;outline:none}
#archiveSearch:focus{border-color:var(--gold)}
#sortSelect{font-size:11px;padding:10px 31px 10px 11px;width:158px}
.archive-table-wrap{max-height:461px;overflow:auto}
.archive-table{width:100%;border-collapse:separate;border-spacing:0;text-align:left;font-variant-numeric:tabular-nums}
.archive-table thead th{position:sticky;top:0;background:#1b2334;color:#b6b5bd;text-transform:uppercase;letter-spacing:.1em;font-size:9px;padding:17px 20px;z-index:2}
.archive-table tbody tr{cursor:pointer;transition:background .16s}
.archive-table tbody tr:hover{background:rgba(214,176,118,.08)}
.archive-table tbody tr.active{background:rgba(227,179,99,.10)}
.archive-table tbody td{border-bottom:1px solid rgba(207,196,176,.07);padding:13px 20px;font-size:12px;color:#d5d3d8}
.archive-table tbody td:first-child{color:#e1c798;font-weight:700}
.archive-table tbody td small{display:block;font-size:9px;color:#989daa;font-weight:400}
.archive-table tbody td:nth-child(n+4){text-align:center}
.archive-table thead th:nth-child(n+4){text-align:center}
.table-symbol{color:#d6b98d;font-family:serif;font-size:18px;margin-right:7px}
.empty-state{text-align:center;padding:40px;color:#aeb3c0;font-size:13px}
