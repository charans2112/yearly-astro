.metric:after{content:"";position:absolute;inset:0;pointer-events:none;z-index:0;border-radius:inherit;background:linear-gradient(118deg,transparent 15%,rgba(255,255,255,.02) 32%,rgba(255,226,169,.095) 47%,rgba(255,255,255,.015) 57%,transparent 72%);background-size:270% 100%;animation:cardShimmer 12s ease-in-out infinite;opacity:.5}
