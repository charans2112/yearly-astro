 function step(now){
   const t=Math.max(0,Math.min(1,(now-start)/duration));
   const ease=1-Math.pow(1-t,3);
   el.textContent=String(Math.round(from+(target-from)*ease));
   if(t<1){counters.set(id,requestAnimationFrame(step));}else{el.textContent=String(target);counters.delete(id)}
 }
 counters.set(id,requestAnimationFrame(step));
}
