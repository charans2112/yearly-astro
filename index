const constellationCanvas=E('constellationCanvas');
let constellationFrame=0;
function revealConstellation(signNumber){
 if(constellationFrame)cancelAnimationFrame(constellationFrame);
 const canvas=constellationCanvas,ctx=canvas.getContext('2d');
 if(!ctx||reduceCinematics()){if(ctx)ctx.clearRect(0,0,canvas.width,canvas.height);return;}
 const rect=canvas.getBoundingClientRect(),size=Math.max(1,rect.width),dpr=Math.min(devicePixelRatio||1,2);
 canvas.width=Math.round(size*dpr);canvas.height=Math.round(size*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);
 const coordinates=CONSTELLATIONS[signNumber-1].map(pt=>[pt[0]*size,pt[1]*size]);
 const start=performance.now(),duration=1640;
 function draw(now){
   const t=Math.min(1,(now-start)/duration),fade=t<.75?1:Math.max(0,(1-t)/.25),growth=Math.min(1,t/.66);
