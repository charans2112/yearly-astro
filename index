   const max=Math.max(1,document.documentElement.scrollHeight-window.innerHeight),scroll=window.scrollY;
   const pct=Math.max(0,Math.min(100,scroll/max*100));
   progress.style.height=pct+'%';glider.style.top=pct+'%';
   const current=sections.reduce((prev,section,i)=>section.getBoundingClientRect().top<window.innerHeight*.4?i:prev,0);
   stops.forEach((el,i)=>{el.classList.toggle('active',i===current);if(i===current)el.setAttribute('aria-current','location');else el.removeAttribute('aria-current')});
   if(!reduceCinematics())nebula.style.transform=`translate3d(0,${-Math.min(95,scroll*.055)}px,0)`;
