// LIVE COSMIC SCENE: fully animated, dependency-free perspective star field, orbital planets and nebulae.
// It is decorative only; the calculators, dropdowns, links and archive remain native HTML controls.
function initLiveCosmos(){
  const canvas=E('spaceCanvas');
  const ctx=canvas && canvas.getContext('2d',{alpha:false});
  if(!ctx) return;
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
  const toggle=E('motionToggle');
  let userPaused=false,hidden=document.visibilityState==='hidden',raf=0;
  let w=1,h=1,dpr=1,last=0,elapsed=0,cameraX=0,cameraY=0,targetX=0,targetY=0,scrollFrac=0;
  let spawnIn=5.2;const meteors=[];
  let seed=21202511;
  const random=()=>{seed=(1664525*seed+1013904223)>>>0;return seed/4294967296};
  const TAU=Math.PI*2;
  const stars=Array.from({length:300},()=>({
     x:(random()-.5)*2.8,y:(random()-.5)*2.3,depth:.08+random()*.92,
     radius:.48+random()*1.32,alpha:.25+random()*.72,twinkle:random()*TAU,speed:.65+random()*1.25,
     hue:random()<.17?'#abcfff':random()<.45?'#ffe1b7':'#f5f9ff'
  }));
  const nebulae=[
    {x:.22,y:.23,rx:370,rgb:'73,111,183',alpha:.085,phase:.2},
    {x:.80,y:.45,rx:320,rgb:'127,78,175',alpha:.065,phase:1.4},
    {x:.48,y:.81,rx:400,rgb:'58,153,142',alpha:.050,phase:2.8},
    {x:.06,y:.69,rx:280,rgb:'188,106,107',alpha:.053,phase:4.1}
  ];
  // Each planet's horizontal and vertical positions are animated on an elliptical orbit.
  // Depth changes along the ellipse, giving genuine 3-D perspective scaling and overdraw.
  const planets=[
    {cx:.87,cy:.23,ox:.070,oy:.085,period:30,phase:.52,r:66,depth:.7,
       colors:['#dbe4ff','#7594c5','#1d335f'],bands:'#d0defe',ring:true,tilt:-.30},
    {cx:.10,cy:.78,ox:.075,oy:.070,period:43,phase:2.43,r:48,depth:.49,
       colors:['#d8fff2','#5b9d94','#17423f'],bands:'#a4e7c6',ring:true,tilt:.22},
    {cx:.16,cy:.24,ox:.087,oy:.073,period:34,phase:4.5,r:35,depth:.57,
       colors:['#fff0bc','#e2a45f','#7a3f2b'],bands:'#fce1b3',ring:false,tilt:0},
    {cx:.85,cy:.79,ox:.088,oy:.079,period:27,phase:1.65,r:35,depth:.85,
       colors:['#eadbff','#9270d0','#392d6c'],bands:'#d5b8f9',ring:false,tilt:0}
  ];
  const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));
  function resize(){
    w=Math.max(1,window.innerWidth);h=Math.max(1,window.innerHeight);
    dpr=Math.min(window.devicePixelRatio||1,w<740?1.35:1.7);
    canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);
    canvas.style.width=w+'px';canvas.style.height=h+'px';
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  function drawNebula(t){
    for(const n of nebulae){
      const x=n.x*w+Math.sin(t*.13+n.phase)*w*.08-cameraX*12;
      const y=n.y*h+Math.cos(t*.10+n.phase)*h*.08-cameraY*7;
      const r=Math.min(n.rx,Math.max(180,w*.35));
      const g=ctx.createRadialGradient(x,y,0,x,y,r);
      g.addColorStop(0,`rgba(${n.rgb},${n.alpha})`);
      g.addColorStop(.38,`rgba(${n.rgb},${n.alpha*.48})`);
      g.addColorStop(1,`rgba(${n.rgb},0)`);
      ctx.fillStyle=g;ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();
    }
  }
  function drawStars(t,dt){
    const scale=Math.max(w,h)*.86;
    for(const s of stars){
      // Distant stars move less than close stars. They also travel gently towards
      // the viewer and re-enter the back of the starfield when their depth wraps.
      s.depth-=dt*.008*s.speed;
      if(s.depth<.06){s.depth=.98;s.x=(random()-.5)*2.8;s.y=(random()-.5)*2.3;}
      const perspective=1.35-s.depth*.82;
      const x=w*.5+(s.x-cameraX*.22)*scale*perspective;
      const y=h*.5+(s.y-cameraY*.20)*scale*perspective+scrollFrac*17*(1-s.depth);
      if(x<-12||y<-12||x>w+12||y>h+12)continue;
      const alpha=s.alpha*(.72+.28*Math.sin(t*(1.0+s.speed)+s.twinkle));
      const radius=s.radius*perspective;
      ctx.globalAlpha=alpha;
      ctx.fillStyle=s.hue;ctx.beginPath();ctx.arc(x,y,radius,0,TAU);ctx.fill();
      if(s.depth<.18){ctx.globalAlpha=alpha*.26;ctx.strokeStyle=s.hue;ctx.lineWidth=radius*.6;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+(x-w*.5)*.011,y+(y-h*.5)*.011);ctx.stroke();}
    }
    ctx.globalAlpha=1;
  }
  function planetState(p,t){
    const a=p.phase+(t/ p.period)*TAU;
    const z=Math.sin(a)*.5+.5;
    const perspective=.81+z*.34;
    return {p,x:(p.cx+Math.cos(a)*p.ox)*w-cameraX*p.depth*26,
              y:(p.cy+Math.sin(a)*p.oy)*h-cameraY*p.depth*15+scrollFrac*(p.depth-.6)*14,
              r:p.r*perspective*clamp(Math.min(w/1100,h/730)*.83+.23,.68,1.3),z};
  }
  function ringStroke(x,y,r,p,front){
    ctx.save();ctx.translate(x,y);ctx.rotate(p.tilt);
    ctx.strokeStyle=front?'rgba(234,228,202,.56)':'rgba(202,213,248,.32)';
    ctx.lineWidth=Math.max(1.5,r*.11);
    ctx.beginPath();ctx.ellipse(0,0,r*1.78,r*.51,0,front?0:Math.PI,front?Math.PI:TAU);ctx.stroke();
    ctx.strokeStyle=front?'rgba(216,219,255,.25)':'rgba(194,203,245,.14)';
    ctx.lineWidth=Math.max(.7,r*.22);
    ctx.beginPath();ctx.ellipse(0,0,r*2.05,r*.59,0,front?0:Math.PI,front?Math.PI:TAU);ctx.stroke();
    ctx.restore();
  }
  function drawPlanet(state,t){
    const {p,x,y,r}=state;
    if(x+r*2.5<0||x-r*2.5>w||y+r*2.5<0||y-r*2.5>h)return;
    const g=ctx.createRadialGradient(x,y,0,x,y,r*2.7);
    g.addColorStop(0,'rgba(123,155,220,.19)');g.addColorStop(.48,'rgba(100,132,190,.07)');g.addColorStop(1,'rgba(100,132,190,0)');
    ctx.fillStyle=g;ctx.beginPath();ctx.arc(x,y,r*2.7,0,TAU);ctx.fill();
    if(p.ring)ringStroke(x,y,r,p,false);
    const body=ctx.createRadialGradient(x-r*.32,y-r*.45,r*.025,x+r*.28,y+r*.26,r*1.28);
    body.addColorStop(0,p.colors[0]);body.addColorStop(.48,p.colors[1]);body.addColorStop(1,p.colors[2]);
    ctx.fillStyle=body;ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();
    // Clip cloud bands to the globe; shift continuously to suggest planetary rotation.
    ctx.save();ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.clip();
    ctx.translate(x,y);ctx.rotate(-.13);const shift=Math.sin(t*.27+p.phase)*r*.18;
    for(let k=-4;k<=4;k++){
      const yy=k*r*.28+shift;
      ctx.beginPath();ctx.moveTo(-r*1.15,yy);
      ctx.bezierCurveTo(-r*.35,yy-r*.12,r*.2,yy+r*.15,r*1.15,yy-r*.04);
      ctx.strokeStyle=k%2?'rgba(248,239,225,.09)':'rgba(7,14,32,.11)';ctx.lineWidth=r*(k%3===0?.13:.07);ctx.stroke();
    }
    ctx.restore();
    // Animated day/night edge follows the scene's moving key light.
    const shade=ctx.createLinearGradient(x-r,y-r*.7,x+r,y+r*.7);
    shade.addColorStop(0,'rgba(0,0,0,0)');shade.addColorStop(.7,'rgba(1,4,17,.06)');shade.addColorStop(1,'rgba(1,4,17,.46)');
    ctx.fillStyle=shade;ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();
    if(p.ring)ringStroke(x,y,r,p,true);
  }
  function drawMeteors(t,dt){
    if(!reduced.matches&&!userPaused){
      spawnIn-=dt;
      if(spawnIn<=0){
        const left=random()<.6;meteors.push({x:(left?-.06:.35+random()*.3)*w,y:(.12+random()*.5)*h,
            vx:(260+random()*220),vy:(100+random()*85),age:0,lifetime:.65+random()*.45});
        spawnIn=4.6+random()*6.7;
      }
    }
    for(let i=meteors.length-1;i>=0;i--){
      const m=meteors[i];m.age+=dt;m.x+=m.vx*dt;m.y+=m.vy*dt;
      if(m.age>m.lifetime){meteors.splice(i,1);continue;}
      const fade=Math.sin(Math.PI*m.age/m.lifetime);
      const trail=ctx.createLinearGradient(m.x-m.vx*.25,m.y-m.vy*.25,m.x,m.y);
      trail.addColorStop(0,'rgba(180,206,255,0)');trail.addColorStop(1,`rgba(235,245,255,${.68*fade})`);
      ctx.strokeStyle=trail;ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(m.x-m.vx*.25,m.y-m.vy*.25);ctx.lineTo(m.x,m.y);ctx.stroke();
      ctx.fillStyle=`rgba(255,253,230,${fade})`;ctx.beginPath();ctx.arc(m.x,m.y,1.7,0,TAU);ctx.fill();
    }
  }
  function draw(dt){
    ctx.clearRect(0,0,w,h);
    const bg=ctx.createLinearGradient(0,0,w,h);
    bg.addColorStop(0,'#0b1530');bg.addColorStop(.48,'#070e20');bg.addColorStop(1,'#030814');
    ctx.fillStyle=bg;ctx.fillRect(0,0,w,h);
    cameraX+=(targetX-cameraX)*Math.min(1,dt*2.9);
    cameraY+=(targetY-cameraY)*Math.min(1,dt*2.9);
    drawNebula(elapsed);
    drawStars(elapsed,dt);
    // Delicate changing elliptical orbital tracks make the motion easy to see.
    for(const p of planets){
      ctx.save();ctx.strokeStyle='rgba(192,199,230,.065)';ctx.lineWidth=.8;
      ctx.setLineDash([2,8]);ctx.beginPath();ctx.ellipse(p.cx*w-cameraX*p.depth*26,p.cy*h-cameraY*p.depth*15,p.ox*w,p.oy*h,0,0,TAU);ctx.stroke();ctx.restore();
    }
    planetStates=planets.map(p=>planetState(p,elapsed)).sort((a,b)=>a.z-b.z);
    for(const state of planetStates)drawPlanet(state,elapsed);
    drawMeteors(elapsed,dt);
  }
  let planetStates=[];
  function step(now){
    raf=0;
    if(hidden||userPaused||reduced.matches)return;
    if(!last)last=now;
    const dt=Math.min(.05,(now-last)/1000);last=now;
    elapsed+=dt;
    draw(dt);
    raf=requestAnimationFrame(step);
  }
  function setState(){
    const stop=userPaused||reduced.matches;
    if(toggle){
      toggle.textContent=stop?'▶ Resume motion':'Ⅱ Pause motion';
      toggle.setAttribute('aria-label',stop?'Resume animated space background':'Pause animated space background');
      toggle.setAttribute('aria-pressed',String(!stop));
    }
    if(stop||hidden){if(raf)cancelAnimationFrame(raf);raf=0;last=0;draw(0);}
    else if(!raf){last=0;raf=requestAnimationFrame(step)}
  }
  resize();draw(0);
  window.addEventListener('resize',()=>{resize();draw(0)},{passive:true});
  window.addEventListener('scroll',()=>{scrollFrac=clamp(window.scrollY/Math.max(1,document.body.scrollHeight-h),0,1)*2-1},{passive:true});
  document.addEventListener('visibilitychange',()=>{hidden=document.visibilityState==='hidden';setState()});
  const mediaChange=()=>setState();
  if(reduced.addEventListener)reduced.addEventListener('change',mediaChange);
  else if(reduced.addListener)reduced.addListener(mediaChange);
  if(toggle)toggle.addEventListener('click',()=>{userPaused=!userPaused;setState()});
  setState();
}
initLiveCosmos();
render();
initCelestialJourney();
})();
</script>
