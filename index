const reducedWheelMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
let wheelAngle=0,spinTimer=null,isSpinning=false,gesture=null,suppressWheelClickUntil=0;
function angleRasi(angle){return ((Math.round(-angle/30)%12)+12)%12+1}
function setWheelAngle(angle,animated=true,duration=760){
  wheelAngle=angle;
  const motion=animated&&!reducedWheelMotion.matches;
  const easing=duration>1500?'cubic-bezier(.12,.73,.1,1)':'cubic-bezier(.16,1,.3,1)';
  const transition=motion?`transform ${duration}ms ${easing}`:'none';
  wheelDisc.style.transition=transition;
  wheelDisc.querySelectorAll('.wheel-sign').forEach(b=>b.style.transition=motion?`transform ${duration}ms ${easing}, background .22s, color .22s, border-color .22s`:'none');
