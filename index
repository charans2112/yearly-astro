#timePortal .portal-ripple:after{inset:22%;border-style:dashed;animation:spin 13s linear infinite}
#timePortal .portal-copy{position:relative;text-align:center;padding:28px 42px;text-shadow:0 3px 26px rgba(0,0,0,.85);animation:portalText 1.12s ease-out both;max-width:min(480px,90vw)}
.portal-overline{display:block;font:700 10px/1.6 var(--sans);letter-spacing:.32em;text-transform:uppercase;color:#e8c384;margin-bottom:10px}
